-- Same retreat as the failsafe, but started on demand (no popup, no low-health needed).
-- Returns true if the retreat started.
local function manualRetreat()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local area = findArea(FAILSAFE_AREA)
    if not humanoid or not root or not area or humanoid.Health <= 0 then
        return false
    end
    if failsafe.retreating then
        return false
    end
    if (root.Position - area.cframe.Position).Magnitude < FAILSAFE_MIN_DISTANCE then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Retreat",
                Text = "You're already at " .. area.name .. ".",
                Duration = 3,
            })
        end)
        return false
    end

    return runRetreatSequence(character, humanoid, area)
end

local gunTemplate = nil
local gunHolder = nil

local function loadGunTemplate()
    if gunTemplate then
        return gunTemplate
    end
    local loadedOk, loadedObjects = pcall(function()
        return game:GetObjects(GUN_MODEL_ID)
    end)
    if not loadedOk or not loadedObjects or not loadedObjects[1] then
        warn("[RickPortal] couldn't load the gun model")
        return nil
    end
    gunTemplate = loadedObjects[1]
    return gunTemplate
end

local function attachGun(character)
    local template = loadGunTemplate()
    if not template then return end

    local arm = character:WaitForChild("Right Arm", 5)
    if not arm then
        warn("[RickPortal] no Right Arm found for the gun")
        return
    end

    if gunHolder then
        gunHolder:Destroy()
        gunHolder = nil
    end

    local newHolder = Instance.new("Model")
    newHolder.Name = "RickPortalGun"
    template:Clone().Parent = newHolder

    local gunParts = {}
    for _, descendant in ipairs(newHolder:GetDescendants()) do
        if descendant:IsA("BaseScript") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            table.insert(gunParts, descendant)
        end
    end
    if #gunParts == 0 then
        warn("[RickPortal] gun model has no parts")
        newHolder:Destroy()
        return
    end

    local handle = newHolder:FindFirstChild("Handle", true)
    if not handle or not handle:IsA("BasePart") then
        handle = gunParts[1]
    end

    local relativeOffsets = {}
    for _, part in ipairs(gunParts) do
        relativeOffsets[part] = handle.CFrame:Inverse() * part.CFrame
    end

    for _, part in ipairs(gunParts) do
        part.Anchored = false
        part.CanCollide = false
        part.Massless = true
        if part ~= handle then
            local partWeld = Instance.new("Weld")
            partWeld.Part0 = handle
            partWeld.Part1 = part
            partWeld.C0 = relativeOffsets[part]
            partWeld.C1 = CFrame.new()
            partWeld.Parent = handle
        end
    end

    handle.Name = "Handle"
    local gunWeld = Instance.new("Weld")
    gunWeld.Name = "RightGrip"
    gunWeld.Part0 = arm
    gunWeld.Part1 = handle
    gunWeld.C0 = GUN_ARM_OFFSET
    gunWeld.C1 = CFrame.new()
    gunWeld.Parent = handle

    newHolder.Parent = character
    gunHolder = newHolder
end

