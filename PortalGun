local StarterGui = game:GetService("StarterGui")

local function performRetreat(character, humanoid, area, track, preflagged)
    local function stopTrack()
        if track and track.IsPlaying then
            track:Stop(0)
        end
    end

    if failsafe.retreating and not preflagged then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or humanoid.Health <= 0 or not root then
        stopTrack()
        failsafe.retreating = false
        return
    end

    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    -- find the floor under the player and lay a portal flat on it
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    rayParams.FilterDescendantsInstances = ignore

    local hit = workspace:Raycast(root.Position, Vector3.new(0, -40, 0), rayParams)
    local floorPos = hit and hit.Position or (root.Position - Vector3.new(0, 3, 0))
    local floorY = floorPos.Y
    local portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
    local ok, err = pcall(buildPortal, CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)
    if not ok then
        warn("[RickPortal] failsafe portal failed: " .. tostring(err))
    end

    failsafe.retreating = true

    task.delay(FAILSAFE_DELAY, function()
        local curRoot = character:FindFirstChild("HumanoidRootPart")
        if not character.Parent or humanoid.Health <= 0 or not curRoot then
            stopTrack()
            failsafe.retreating = false
            return
        end

        -- remember + disable the floor parts under the portal
        local floorParts = {}
        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = ignore
        local found = workspace:GetPartBoundsInBox(CFrame.new(floorPos.X, floorY - 8, floorPos.Z), Vector3.new(10, 20, 10), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(floorParts, part)
                part.CanCollide = false
            end
        end

        -- remember + disable the character's collision
        local charParts = {}
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("BasePart") then
                charParts[d] = d.CanCollide
                d.CanCollide = false
            end
        end

        -- PlatformStand stops the humanoid from holding you up off the ground
        local prevPlatformStand = humanoid.PlatformStand
        humanoid.PlatformStand = true
        curRoot.AssemblyLinearVelocity = Vector3.new(0, -12, 0)

        local done = false
        local conn = nil
        local started = os.clock()

        local function finish(doTeleport)
            if done then return end
            done = true
            if conn then
                conn:Disconnect()
                conn = nil
            end
            stopTrack()

            for part, original in pairs(charParts) do
                if part.Parent then
                    part.CanCollide = original
                end
            end
            for _, part in ipairs(floorParts) do
                if part.Parent then
                    part.CanCollide = true
                end
            end
            if humanoid.Parent then
                humanoid.PlatformStand = prevPlatformStand
            end
            failsafe.retreating = false

            if doTeleport then
                local r = character:FindFirstChild("HumanoidRootPart")
                if r and humanoid.Health > 0 then
                    teleportToArea(r, area, nil, { floorExit = true })
                end
            end
        end

        conn = RunService.Stepped:Connect(function()
            if not character.Parent or humanoid.Health <= 0 or not curRoot.Parent then
                finish(false)
                return
            end
            -- the humanoid keeps trying to turn collision back on, so keep it off
            for part in pairs(charParts) do
                if part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
            if curRoot.Position.Y <= floorY - FAILSAFE_FALL_DEPTH or os.clock() - started > FAILSAFE_FALL_TIMEOUT then
                finish(true)
            end
        end)
    end)
end

-- The full retreat: wave animation + pre-open sound, then the floor portal 0.1s later.
-- Both the mini button and the Retreat? popup use this so they look identical.
local function runRetreatSequence(character, humanoid, area)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or not root or humanoid.Health <= 0 or failsafe.retreating then
        return false
    end

    failsafe.retreating = true
    local track = playCharacterAnimation(character, RETREAT_ANIMATION_ID)
    playSounds({ PRE_OPEN_SOUND }, root)
    task.delay(RETREAT_START_DELAY, function()
        performRetreat(character, humanoid, area, track, true)
    end)
    return true
end

local function triggerFailsafe(character, humanoid)
    local area = findArea(FAILSAFE_AREA)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not area or not root then return end
    if (root.Position - area.cframe.Position).Magnitude < FAILSAFE_MIN_DISTANCE then return end

    -- disarmed until health goes back above the threshold (or you respawn)
    failsafe.armed = false
    failsafe.lastTrigger = os.clock()

    local callback = Instance.new("BindableFunction")
    callback.OnInvoke = function(choice)
        if choice == "Yes" then
            runRetreatSequence(character, humanoid, area)
        end
        task.defer(function()
            callback:Destroy()
        end)
    end
    task.delay(FAILSAFE_PROMPT_TIME + 2, function()
        if callback.Parent == nil then
            callback:Destroy()
        end
    end)

    local ok, err = pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Retreat?",
            Text = string.format("Health is low (%d). Teleport to %s?", math.floor(humanoid.Health), area.name),
            Duration = FAILSAFE_PROMPT_TIME,
            Button1 = "Yes",
            Button2 = "No",
            Callback = callback,
        })
    end)
    if not ok then
        warn("[RickPortal] couldn't show the Retreat? prompt: " .. tostring(err))
        callback:Destroy()
    end
end

local function bindFailsafe(character)
    failsafe.bindId = failsafe.bindId + 1
    local myId = failsafe.bindId
    for _, c in ipairs(failsafe.conns) do
        c:Disconnect()
    end
    table.clear(failsafe.conns)
    failsafe.armed = true

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or failsafe.bindId ~= myId then return end

    table.insert(failsafe.conns, humanoid.HealthChanged:Connect(function(health)
        if health > failsafe.threshold then
            failsafe.armed = true
            return
        end
        if not failsafe.enabled or not failsafe.armed or health <= 0 then return end
        if os.clock() - failsafe.lastTrigger < FAILSAFE_COOLDOWN then return end
        triggerFailsafe(character, humanoid)
    end))
end

