local function bounce(t)
    if t <= 0 then
        return 0
    end
    return 1 - math.exp(-DAMPING * t) * math.cos(FREQUENCY * t)
end

local function getTargets()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local root = p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if root then
            table.insert(list, { name = p.Name, displayName = p.DisplayName, root = root, userId = p.UserId, player = p })
        end
    end

    local live = workspace:FindFirstChild("Live")
    local dummy = live and live:FindFirstChild("Weakest Dummy")
    local dummyRoot = dummy and dummy:FindFirstChild("HumanoidRootPart")
    if dummyRoot then
        table.insert(list, { name = "Weakest Dummy", displayName = "Weakest Dummy", root = dummyRoot, model = dummy })
    end

    return list
end

local function pickTarget()
    local list = getTargets()
    if #list == 0 then
        return nil
    end
    return list[math.random(1, #list)].root
end

local activeFovTween = nil

local function snapFieldOfView()
    local camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
    end
    camera.FieldOfView = PORTAL_FOV_SNAP
    activeFovTween = TweenService:Create(
        camera,
        TweenInfo.new(PORTAL_FOV_RETURN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { FieldOfView = PORTAL_FOV_REST }
    )
    activeFovTween:Play()
end

local function zoomFieldOfView(duration)
    local camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
    end
    activeFovTween = TweenService:Create(
        camera,
        TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { FieldOfView = PORTAL_FOV_ZOOM }
    )
    activeFovTween:Play()
end

local function playSounds(ids, parent)
    if not parent then return end
    for _, entry in ipairs(ids) do
        local id = type(entry) == "table" and entry.id or entry
        local volume = type(entry) == "table" and entry.volume or SOUND_VOLUME
        local sound = Instance.new("Sound")
        sound.SoundId = id
        sound.Volume = volume
        sound.Parent = parent
        sound.Ended:Once(function()
            sound:Destroy()
        end)
        sound:Play()
        task.delay(15, function()
            if sound.Parent then
                sound:Destroy()
            end
        end)
    end
end

local function playCharacterAnimation(character, animationId)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local animation = Instance.new("Animation")
    animation.AnimationId = animationId
    local loaded, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if loaded and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track.Stopped:Once(function()
            animation:Destroy()
        end)
        return track
    else
        warn("[RickPortal] animation failed to load: " .. animationId)
        animation:Destroy()
        return nil
    end
end

local shootTrack = nil

local function teleportOut(root, landPos, faceAt)
    local flat = Vector3.new(faceAt.X - landPos.X, 0, faceAt.Z - landPos.Z)
    local look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    root.CFrame = CFrame.lookAt(landPos, landPos + look)
    root.AssemblyLinearVelocity = Vector3.zero

    if shootTrack and shootTrack.IsPlaying then
        shootTrack:Stop(0)
    end
    shootTrack = nil

    playCharacterAnimation(root.Parent, EXIT_ANIMATION_ID)
end

local function makeFace(frame, face)
    local gui = Instance.new("SurfaceGui")
    gui.Face = face
    gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    gui.CanvasSize = Vector2.new(512, 512)
    gui.LightInfluence = 0
    gui.Brightness = 1
    gui.AlwaysOnTop = false
    gui.Parent = frame

    local img = Instance.new("ImageLabel")
    img.BackgroundTransparency = 1
    img.Image = textureUrl
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.fromScale(0.5, 0.5)
    img.Size = UDim2.fromScale(textureScale.X, textureScale.Y)
    img.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = img
    return img
end

local function destroyPortal(p)
    if p.conn then p.conn:Disconnect() end
    if p.touchConn then p.touchConn:Disconnect() end
    if p.frame then p.frame:Destroy() end
    if p.trigger then p.trigger:Destroy() end
    portals[p] = nil
end

local function closePortal(p)
    if p.state ~= "closing" then
        p.state = "closing"
        p.stateStart = os.clock()
        p.armed = false
    end
end

local function shootOrb(fromPos, toPos, travelTime)
    local orb = Instance.new("Part")
    orb.Shape = Enum.PartType.Ball
    orb.Material = Enum.Material.Neon
    orb.Color = GLOW_COLOR
    orb.Size = Vector3.new(1.2, 1.2, 1.2)
    orb.Anchored = true
    orb.CanCollide = false
    orb.CanTouch = false
    orb.CanQuery = false
    orb.CastShadow = false
    orb.Position = fromPos
    orb.Parent = workspace

    local tw = TweenService:Create(
        orb,
        TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = toPos, Size = Vector3.new(0.4, 0.4, 0.4) }
    )
    tw:Play()
    tw.Completed:Wait()
    orb:Destroy()
end

local function buildPortal(portalCF, decorative)
    local p = { state = "opening", stateStart = os.clock(), spawnTime = os.clock(), armed = false, decorative = decorative }
    if not decorative then
        snapFieldOfView()
    end

    local frame = Instance.new("Part")
    frame.Name = "RickPortal"
    frame.Transparency = 1
    frame.Size = Vector3.new(0.05, 0.05, DISC_THICKNESS)
    frame.Anchored = true
    frame.CanCollide = false
    frame.CanTouch = false
    frame.CanQuery = false
    frame.CastShadow = false
    frame.CFrame = portalCF

    p.labels = {
        makeFace(frame, Enum.NormalId.Front),
        makeFace(frame, Enum.NormalId.Back),
    }

    local light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 0
    light.Brightness = 0
    light.Shadows = false
    light.Parent = frame
    p.light = light

    TweenService:Create(
        light,
        TweenInfo.new(LIGHT_TWEEN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Range = LIGHT_RANGE }
    ):Play()

    frame.Parent = workspace
    p.frame = frame
    playSounds(OPEN_SOUNDS, frame)

    -- Walking into a portal isn't enough: you have to go all the way THROUGH it, and a bit
    -- past (ENTER_DEPTH studs beyond the portal's face), inside its opening, before it fires.
    local function enter(root)
        local area = chosenArea
        chosenArea = nil

        if area then
            chosenTarget = nil
            p.armed = false
            teleportToArea(root, area, p)
            return
        end

        local tRoot = (chosenTarget and chosenTarget:IsDescendantOf(workspace)) and chosenTarget or pickTarget()
        chosenTarget = nil
        if not tRoot then
            warn("[RickPortal] no other player to teleport to")
            return
        end

        p.armed = false
        local landPos = (tRoot.CFrame * CFrame.new(0, 0, ARRIVE_DISTANCE + RETURN_PORTAL_OFFSET - EXIT_PORTAL_FRONT_DISTANCE)).Position
        local exitPos = (tRoot.CFrame * CFrame.new(0, 0, ARRIVE_DISTANCE + RETURN_PORTAL_OFFSET)).Position
        snapFieldOfView()
        teleportOut(root, landPos, tRoot.Position)
        closePortal(p)

        local retPos = Vector3.new(exitPos.X, tRoot.Position.Y + SPAWN_HEIGHT, exitPos.Z)
        buildPortal(CFrame.lookAt(retPos, Vector3.new(landPos.X, retPos.Y, landPos.Z)), true)
    end

    p.conn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        local t = now - p.stateStart
        local w, h

        if not p.decorative and p.state ~= "closing" then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local rel = portalCF:PointToObjectSpace(root.Position)
                local prev = p.lastRel
                p.lastRel = rel

                -- startSide = the side of the portal you came from (+1 or -1 along its normal)
                if p.startSide == nil then
                    p.startSide = rel.Z >= 0 and 1 or -1
                elseif math.abs(rel.Z) > ENTER_DEPTH + 1 then
                    p.startSide = rel.Z > 0 and 1 or -1
                end

                -- depth = how far past the plane you are, measured away from where you started
                if p.armed and prev then
                    local dPrev = -p.startSide * prev.Z
                    local dNow = -p.startSide * rel.Z
                    if dPrev < ENTER_DEPTH and dNow >= ENTER_DEPTH then
                        -- where on the portal's opening did you cross the "deep" line?
                        local alpha = (ENTER_DEPTH - dPrev) / (dNow - dPrev)
                        local crossX = prev.X + (rel.X - prev.X) * alpha
                        local crossY = prev.Y + (rel.Y - prev.Y) * alpha
                        if math.abs(crossX) <= TRIGGER_SIZE.X / 2 and math.abs(crossY) <= TRIGGER_SIZE.Y / 2 then
                            enter(root)
                        end
                    end
                end
            else
                p.lastRel = nil
            end
        end

        if p.state == "opening" then
            w = PORTAL_SIZE * bounce(t)
            h = PORTAL_SIZE * bounce(t - STAGGER)
            if t >= ARM_DELAY and not p.decorative then p.armed = true end
            if t >= OPEN_TIME then
                if p.decorative then
                    closePortal(p)
                else
                    p.state = "open"
                    p.stateStart = now
                end
            end
        elseif p.state == "open" then
            w = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED))
            h = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED + 1.2))
            if t >= PORTAL_LIFETIME then
                closePortal(p)
            end
        else
            local u = math.clamp(t / CLOSE_TIME, 0, 1)
            w = PORTAL_SIZE * (1 - TweenService:GetValue(u, Enum.EasingStyle.Back, Enum.EasingDirection.In))
            h = PORTAL_SIZE * (1 - TweenService:GetValue(math.min(u * 1.25, 1), Enum.EasingStyle.Back, Enum.EasingDirection.In))
            if u >= 1 then
                destroyPortal(p)
                return
            end
        end

        w = math.max(w, 0.05)
        h = math.max(h, 0.05)

        frame.Size = Vector3.new(w * widthScale, h, DISC_THICKNESS)

        local rot = ((now - p.spawnTime) * SPIN_SPEED) % 360
        for _, lbl in ipairs(p.labels) do
            lbl.Rotation = rot
        end
        light.Brightness = LIGHT_BRIGHTNESS * math.clamp(w / PORTAL_SIZE, 0, 1.3)
    end)

    portals[p] = true
    return p
end

teleportToArea = function(root, area, fromPortal, opts)

    local origin = root.CFrame
    local flat = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
    local look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    local landPos = area.cframe.Position
    local floorExit = opts and opts.floorExit

    local floorPos = nil
    if floorExit then
        -- find the floor at the destination and put the exit portal flat on it
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.RespectCanCollide = true
        local ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        rayParams.FilterDescendantsInstances = ignore
        local hit = workspace:Raycast(landPos + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rayParams)
        floorPos = hit and hit.Position or (landPos - Vector3.new(0, 3, 0))
        landPos = Vector3.new(landPos.X, floorPos.Y + 2.5, landPos.Z)
    end

    snapFieldOfView()
    teleportOut(root, landPos, landPos + look)
    if fromPortal then
        closePortal(fromPortal)
    end

    if floorExit then
        local portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
        buildPortal(CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)

        -- throw the player out of the portal, up and forward
        local launch = Vector3.new(look.X * FAILSAFE_LAUNCH_FWD, FAILSAFE_LAUNCH_UP, look.Z * FAILSAFE_LAUNCH_FWD)
        local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        root.AssemblyLinearVelocity = launch
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
        RunService.Heartbeat:Once(function()
            if root.Parent then
                root.AssemblyLinearVelocity = launch
            end
        end)
    else
        local retPos = Vector3.new(
            landPos.X - look.X * EXIT_PORTAL_FRONT_DISTANCE,
            landPos.Y + SPAWN_HEIGHT,
            landPos.Z - look.Z * EXIT_PORTAL_FRONT_DISTANCE
        )
        buildPortal(CFrame.lookAt(retPos, Vector3.new(landPos.X, retPos.Y, landPos.Z)), true)
    end
end

local function openPortal(target)
    if shooting then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[RickPortal] no character / HumanoidRootPart found")
        return
    end

    local rootCF = root.CFrame
    local center = (rootCF * CFrame.new(0, SPAWN_HEIGHT, -SPAWN_DISTANCE)).Position

    local portalCF = CFrame.lookAt(center, Vector3.new(rootCF.Position.X, center.Y, rootCF.Position.Z))

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end
    rayParams.FilterDescendantsInstances = ignore

    local rayOrigin = rootCF.Position + Vector3.new(0, SPAWN_HEIGHT, 0)
    local hit = workspace:Raycast(rayOrigin, center - rayOrigin, rayParams)
    local orbEnd = center
    if hit and math.abs(hit.Normal.Y) < WALL_MAX_NORMAL_Y then
        orbEnd = hit.Position
        local stuckPos = hit.Position + hit.Normal * WALL_OFFSET

        portalCF = CFrame.lookAt(stuckPos, stuckPos + hit.Normal)
    end

    local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or root
    local fromPos = hand.Position

    for p in pairs(portals) do
        closePortal(p)
    end

    chosenTarget = typeof(target) == "Instance" and target or nil
    chosenArea = (type(target) == "table" and typeof(target.cframe) == "CFrame") and target or nil
    shooting = true
    shootTrack = playCharacterAnimation(char, SHOOT_ANIMATION_ID)
    playSounds(SHOOT_SOUNDS, root)
    task.spawn(function()

        local shotTime = math.max(SHOT_TIME * (orbEnd - fromPos).Magnitude / (center - fromPos).Magnitude, 0.08)
        zoomFieldOfView(shotTime)
        task.delay(math.max(shotTime - PRE_OPEN_TIME, 0), function()
            playSounds({ PRE_OPEN_SOUND }, root)
        end)
        local orbOk, orbErr = pcall(shootOrb, fromPos, orbEnd, shotTime)
        if not orbOk then warn("[RickPortal] orb failed: " .. tostring(orbErr)) end
        shooting = false
        local buildOk, buildErr = pcall(buildPortal, portalCF)
        if not buildOk then warn("[RickPortal] portal failed: " .. tostring(buildErr)) end
    end)
end

